return {
    titre = "Cupcakes au Chocolat",
    image = "",
    portions = "6",
    prep = "30mn",
    cuisson = "20mn",
    ingredients = [[
    \parthead{Appareil}\ll
      Yaourt Nature & 1\ll
      \OE ufs & 3\ll
      Farine & 170g\ll
      Levure & 1 sachet\ll
      Sucre Roux & 150g\ll
      Beurre Fondu & 150g\ll
      Cacao & 3 c.à.c.\ll
      \parthead{Décoration}\ll
      Chocolat Noir & 100g\ll
      Crème Liquide & 25cl\ll
      Vermicelles Colorés & \ll
      Myrtilles & 18\ll
    ]],
    etapes = [[
    \item Préchauffer le four à 180°C. 
    \item Mélanger au fouet électrique le yaourt, les \oe ufss, le sucre et le beurre fondu. 
    \item Ajouter la farine, la levure et le cacao. 
    \item Répartir la pâte dans des caissettes et enfourner pour 15-20mn. 
    \item Faire fondre le chocolat en morceaux avec 5cl de crème puis le lisser. Monter en chantilly le reste de crème puis ajouter le chocolat fondu. 
    \item Décorer les cupcakes avec la chantilly puis parsemer de vermicelles et de myrtilles.
    ]],
